---
type FactIconName = 'species' | 'duration' | 'season' | 'guiding';

interface Props {
  name: FactIconName;
}

const { name } = Astro.props;
---

<svg
  class="hunt-fact-icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'species' && (
    <>
      <circle cx="11" cy="4.5" r="1.8" />
      <circle cx="17.5" cy="8" r="1.8" />
      <circle cx="4.5" cy="8" r="1.8" />
      <path d="M12 11c-3.4 0-6 2.5-6 5.3 0 2 1.5 3.5 3.4 3.5 1 0 1.7-.5 2.6-.5s1.6.5 2.6.5c1.9 0 3.4-1.5 3.4-3.5 0-2.8-2.6-5.3-6-5.3Z" />
    </>
  )}
  {name === 'duration' && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M12 7.5V12l3 2" />
    </>
  )}
  {name === 'season' && (
    <>
      <rect x="3.5" y="5" width="17" height="15" rx="2" />
      <path d="M7.5 3.5v3M16.5 3.5v3M3.5 9h17" />
      <path d="M8 13h.01M12 13h.01M16 13h.01M8 16.5h.01M12 16.5h.01" stroke-width="2.4" />
    </>
  )}
  {name === 'guiding' && (
    <>
      <circle cx="9" cy="8" r="3" />
      <path d="M3.8 19c.5-3.5 2.3-5.3 5.2-5.3s4.7 1.8 5.2 5.3" />
      <circle cx="17" cy="9" r="2.2" />
      <path d="M15.3 14.3c.6-.3 1.2-.4 1.9-.4 2.2 0 3.5 1.4 3.9 4.1" />
    </>
  )}
</svg>

<style>
  .hunt-fact-icon {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
  }
</style>
