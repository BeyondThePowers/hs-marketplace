---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HuntFactIcon from '../../components/HuntFactIcon.astro';
import { loadCatalogSnapshot, mediaUrl } from '../../lib/catalog-build';
import { destinationFacetKey, destinationLabel, destinationSlug, huntDestinations } from '../../lib/hunt-destinations';

export const prerender = true;

export async function getStaticPaths() {
  const catalog = await loadCatalogSnapshot();
  return catalog.hunts
    .filter((hunt) => hunt.listing_id && hunt.id)
    .map((hunt) => {
      const huntDestinationKeys = new Set(huntDestinations(hunt.destinations).map(destinationFacetKey));
      const sharesDestination = (candidate: typeof hunt) => huntDestinations(candidate.destinations).some((destination) => huntDestinationKeys.has(destinationFacetKey(destination)));
      const relations = catalog.huntLodges.filter((relation) => relation.hunt_id === hunt.id);
      const lodgeIds = new Set(relations.map((relation) => relation.lodge_record_id));
      return {
        params: { listingId: hunt.listing_id! },
        props: {
          hunt,
          media: catalog.huntMedia.filter((item) => item.hunt_id === hunt.id),
          accommodations: relations.map((relation) => ({
            relation,
            lodge: catalog.lodges.find((lodge) => lodgeIds.has(lodge.id) && lodge.id === relation.lodge_record_id),
            media: catalog.lodgeMedia.filter((item) => item.lodge_record_id === relation.lodge_record_id),
          })),
          relatedHunts: catalog.hunts
            .filter((candidate) => candidate.id !== hunt.id && (
              sharesDestination(candidate) ||
              candidate.trip_type === hunt.trip_type ||
              (candidate.primary_species ?? []).some((species) => (hunt.primary_species ?? []).includes(species))
            ))
            .sort((a, b) => {
              const score = (candidate: typeof hunt) =>
                Number(sharesDestination(candidate)) * 3 +
                Number(candidate.trip_type === hunt.trip_type) * 2 +
                (candidate.primary_species ?? []).filter((species) => (hunt.primary_species ?? []).includes(species)).length;
              return score(b) - score(a);
            })
            .slice(0, 3)
            .map((candidate) => ({
              hunt: candidate,
              media: catalog.huntMedia.find((item) => item.hunt_id === candidate.id),
            })),
        },
      };
    });
}

const { hunt, media, accommodations, relatedHunts } = Astro.props;
const destinations = huntDestinations(hunt.destinations);
const record = (value: unknown): Record<string, unknown> | null =>
  value && typeof value === 'object' && !Array.isArray(value) ? value as Record<string, unknown> : null;
const records = (value: unknown): Array<Record<string, unknown>> =>
  Array.isArray(value) ? value.filter((item) => record(item)).map((item) => item as Record<string, unknown>) : [];
const strings = (value: unknown): string[] => Array.isArray(value) ? value.map(String).filter(Boolean) : [];
const humanize = (value: unknown) => String(value ?? '').replaceAll('-', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());
const arrangedAccommodations = Array.isArray(hunt.accommodations)
  ? (hunt.accommodations as Array<Record<string, unknown>>).filter((item) => item.type === 'arranged')
  : [];
const heroImage = media[0] ? mediaUrl(media[0]) : null;
const galleryMedia = media.slice(0, 10).filter((item) => mediaUrl(item));
const formatPrice = (amount: number | null, currency: string | null) =>
  amount === null
    ? 'Contact for price'
    : new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: currency || 'USD',
        maximumFractionDigits: 0,
      }).format(amount);

const duration = (hunt.duration_and_party ?? hunt.duration) as Record<string, unknown> | null;
const season = (hunt.season_and_availability ?? hunt.season) as Record<string, unknown> | null;
const inquiryRules = record(season?.inquiryRules);
const methodsAndGuiding = record(hunt.methods_and_guiding);
const pricing = record(hunt.pricing);
const priceOptions = records(pricing?.options);
const travel = record(hunt.travel);
const airports = records(travel?.nearestAirports);
const equipment = record(hunt.equipment_and_licenses);
const gunRental = record(equipment?.gunRental);
const territory = record(hunt.territory);
const territorySize = record(territory?.size);
const terms = record(hunt.terms);
const optionalServices = records(hunt.optional_services);
const classification = record(hunt.classification);
const taxonomyNames = (value: unknown) => records(value).map((item) => String(item.name ?? item.key ?? '')).filter(Boolean);
const equipmentTaxonomy = taxonomyNames(classification?.equipment);
const techniqueTaxonomy = taxonomyNames(classification?.techniques);
const displayedEquipment = equipmentTaxonomy;
const displayedTechniques = techniqueTaxonomy;
const accessMethods = taxonomyNames(territory?.accessMethods);
const countLabel = (value: unknown, singular: string, plural = `${singular}s`) => {
  const count = Number(value);
  return Number.isFinite(count) ? `${count} ${count === 1 ? singular : plural}` : null;
};
const durationLabel = duration
  ? [duration.huntingDays && countLabel(duration.huntingDays, 'hunting day'), duration.nights !== undefined && countLabel(duration.nights, 'night')]
      .filter(Boolean)
      .join(', ') || String(duration.label ?? duration.days ?? 'See package details')
  : null;
const seasonLabel = season ? String(season.display ?? season.label ?? season.summary ?? 'Ask outfitter') : null;
const tripTypeLabel = hunt.trip_type === 'BigGame' ? 'Big game' : hunt.trip_type;
const huntFormatLabel = methodsAndGuiding?.arrangement
  ? `${humanize(methodsAndGuiding.arrangement)} ${String(tripTypeLabel).toLowerCase()}`
  : tripTypeLabel;
const structuredSectionTypes = new Set(['overview', 'highlights', 'hunting', 'inclusions', 'exclusions', 'optionalServices', 'itinerary', 'travel', 'equipment', 'terms', 'faq']);
const sections = (Array.isArray(hunt?.sections) ? hunt.sections : [])
  .map((section) => {
    if (!section || typeof section !== 'object' || Array.isArray(section)) return null;
    const item = section as Record<string, unknown>;
    if (structuredSectionTypes.has(String(item.type ?? ''))) return null;
    const body = item.body ?? item.content ?? item.description;
    if (!body) return null;
    return {
      heading: String(item.heading ?? item.title ?? 'Package details'),
      body,
    };
  })
  .filter((section): section is { heading: string; body: unknown } => section !== null);
const editorial = hunt.editorial && typeof hunt.editorial === 'object' && !Array.isArray(hunt.editorial)
  ? hunt.editorial as Record<string, unknown>
  : null;
const overviewDescription = typeof editorial?.description === 'string' ? editorial.description : null;
const highlights = Array.isArray(editorial?.highlights)
  ? (editorial.highlights as unknown[]).map(String)
  : [];
const inclusions = Array.isArray(hunt.inclusions) ? hunt.inclusions.map(String) : [];
const exclusions = Array.isArray(hunt.exclusions) ? hunt.exclusions.map(String) : [];
const itinerary = Array.isArray(hunt.itinerary) ? hunt.itinerary as Array<Record<string, unknown>> : [];
const faqs = Array.isArray(hunt.faqs) ? hunt.faqs as Array<Record<string, unknown>> : [];
const inquiry = hunt.outfitter_inquiry && typeof hunt.outfitter_inquiry === 'object' && !Array.isArray(hunt.outfitter_inquiry)
  ? hunt.outfitter_inquiry as Record<string, unknown>
  : null;
const directInquiry = inquiry?.mode === 'source-endpoint' && typeof inquiry.submissionUrl === 'string'
  ? inquiry
  : null;
const inquiryActionLabel = directInquiry ? 'Ask the outfitter' : 'Contact outfitter';
const titleWordCount = String(hunt.title ?? '').trim().split(/\s+/).filter(Boolean).length;
const titleLength = String(hunt.title ?? '').length;
const titleSizeClass = titleLength > 58 || titleWordCount > 9
  ? 'title-extra-long'
  : titleLength > 34 || titleWordCount > 6
    ? 'title-long'
    : undefined;
const lodgeRegion = (location: unknown) => {
  if (!location || typeof location !== 'object' || Array.isArray(location)) return null;
  return String((location as Record<string, unknown>).region ?? '') || null;
};
const canonicalUrl = new URL(`/hunts/${hunt.listing_id}`, Astro.site ?? Astro.url.origin).toString();
const priceBasis = (value: unknown) => ({
  'per-hunter-per-trip': 'per hunter, per trip',
  'per-hunter-per-day': 'per hunter, per day',
  'per-group-per-trip': 'per group, per trip',
  'daily-rate': 'per day',
  'starting-from': 'starting price',
}[String(value)] ?? humanize(value));
const inquiryAvailability = season?.mode === 'verified-windows' ? 'Verified date windows' : 'Dates confirmed by inquiry';
const huntSchema = [{
  '@context': 'https://schema.org',
  '@type': 'Product',
  sku: hunt.listing_id,
  name: hunt.title,
  description: hunt.summary,
  image: media.map((item) => mediaUrl(item)).filter(Boolean),
  url: canonicalUrl,
  category: tripTypeLabel,
  seller: { '@type': 'Organization', name: hunt.outfitter_name, url: hunt.outfitter_profile_url },
  areaServed: destinations.map((destination) => ({ '@type': 'Place', name: `${destination.region.name}, ${destination.country.name}` })),
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Primary species', value: (hunt.primary_species ?? []).join(', ') },
    { '@type': 'PropertyValue', name: 'Duration', value: durationLabel },
    { '@type': 'PropertyValue', name: 'Season', value: seasonLabel },
    methodsAndGuiding?.arrangement && { '@type': 'PropertyValue', name: 'Guiding', value: humanize(methodsAndGuiding.arrangement) },
  ].filter(Boolean),
  offers: hunt.starting_price === null ? undefined : {
    '@type': 'Offer',
    price: hunt.starting_price,
    priceCurrency: hunt.currency || 'USD',
    availability: 'https://schema.org/LimitedAvailability',
    url: canonicalUrl,
  },
}, {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Hunts', item: new URL('/#hunts', Astro.site ?? Astro.url.origin).toString() },
    { '@type': 'ListItem', position: 2, name: hunt.title, item: canonicalUrl },
  ],
}];
---

<BaseLayout
  title={hunt ? `${hunt.title} | HuntSeeker` : 'Hunt not found | HuntSeeker'}
  description={hunt?.summary || 'This hunt is not currently available in the marketplace.'}
  canonicalPath={`/hunts/${hunt.listing_id}`}
  image={heroImage}
  structuredData={huntSchema}
>
  {hunt ? (
    <>
      <header class="trip-intro">
        <div class="trip-intro-inner detail-wide">
          <div class="trip-utility">
            <a class="trip-back" href="/#hunts"><span aria-hidden="true">←</span> All hunts</a>
            <nav class="trip-breadcrumbs" aria-label="Breadcrumb">
              <a href="/#hunts">Hunts</a><span aria-hidden="true">/</span>
              {destinations.slice(0, 1).map((destination) => <a href={`/destinations/${destinationSlug(destination)}`}>{destination.region.name}</a>)}
            </nav>
          </div>

          <div class="trip-media" id="photos" aria-label={`${hunt.title} photographs`}>
            {galleryMedia.length > 0 ? (
              <>
                <button class="trip-media-primary" type="button" data-gallery-index="0" aria-label={`Open photo gallery, ${galleryMedia.length} photos`}>
                  <img
                    src={mediaUrl(galleryMedia[0]) || ''}
                    alt={galleryMedia[0].alt || hunt.title || ''}
                    loading="eager"
                    decoding="async"
                    fetchpriority="high"
                  />
                  <span class="photo-count" aria-hidden="true"><span class="photo-icon">▣</span> {galleryMedia.length} {galleryMedia.length === 1 ? 'photo' : 'photos'}</span>
                </button>
                {galleryMedia.length > 1 && (
                  <div class="trip-media-rail">
                    {galleryMedia.slice(1, 3).map((item, index) => (
                      <button class="trip-media-secondary" type="button" data-gallery-index={String(index + 1)} aria-label={`Open photo ${index + 2} of ${galleryMedia.length}`}>
                        <img src={mediaUrl(item) || ''} alt="" loading="lazy" decoding="async" />
                      </button>
                    ))}
                  </div>
                )}
              </>
            ) : (
              <div class="trip-media-placeholder"><span>Hunt photography coming soon</span></div>
            )}
          </div>

          <div class="trip-decision">
            <p class="trip-location">{destinations.map((destination, index) => <>{index > 0 && ' · '}<a href={`/destinations/${destinationSlug(destination)}`}>{destination.region.name}, {destination.country.name}</a></>)}</p>
            <h1 class={titleSizeClass}>{hunt.title}</h1>
            <p class="trip-outfitter">Offered by <strong>{hunt.outfitter_name}</strong></p>
            <p class="trip-summary">{hunt.summary}</p>

            <dl class="trip-key-facts">
              {(hunt.primary_species ?? []).length > 0 && <div><dt><HuntFactIcon name="species" /> <span>Species</span></dt><dd>{hunt.primary_species.slice(0, 3).join(', ')}</dd></div>}
              {durationLabel && <div><dt><HuntFactIcon name="duration" /> <span>Duration</span></dt><dd>{durationLabel}</dd></div>}
              {seasonLabel && <div><dt><HuntFactIcon name="season" /> <span>Season</span></dt><dd>{seasonLabel}</dd></div>}
              <div><dt><HuntFactIcon name="tripType" /> <span>Hunt format</span></dt><dd>{huntFormatLabel}</dd></div>
            </dl>

            <div class="trip-action" data-inline-trip-action>
              <div class="trip-price">
                <span>{hunt.starting_price === null ? 'Pricing' : 'Starting from'}</span>
                <strong>{formatPrice(hunt.starting_price, hunt.currency)}</strong>
                {priceOptions[0]?.basis && String(priceOptions[0].basis) !== 'starting-from' && <small>{priceBasis(priceOptions[0].basis)}</small>}
              </div>
              <a class="trip-primary-action" href="#inquiry">{inquiryActionLabel}</a>
            </div>
            <p class="trip-confirmation">Your inquiry goes directly to {hunt.outfitter_name}, who will confirm dates, pricing, and final package terms.</p>
            {hunt.source_url && <a class="trip-source-link" href={hunt.source_url}>View the outfitter's original listing <span aria-hidden="true">↗</span></a>}
          </div>
        </div>
      </header>

      <nav class="detail-nav" aria-label="Hunt page sections">
        <div class="detail-nav-inner detail-wide">
          <span class="detail-nav-label">On this page</span>
          <div class="detail-nav-links">
            <a href="#overview" aria-current="location">Overview</a>
            <a href="#experience">The hunt</a>
            {season && <a href="#timing">Dates</a>}
            {(accommodations.length > 0 || arrangedAccommodations.length > 0 || airports.length > 0 || travel?.transferTime) && <a href="#stay-travel">Stay and travel</a>}
            <a href="#package">Package</a>
            {equipment && <a href="#preparation">Preparation</a>}
            <a href="#terms">Terms</a>
          </div>
        </div>
      </nav>

      <section class="detail-wide detail-layout">
        <article>
          <section class="overview-card" id="overview">
            <p class="section-label">Overview</p>
            <h2 class="summary">About this hunt</h2>
            {overviewDescription && <p class="overview-description">{overviewDescription}</p>}

            {highlights.length > 0 && (
              <ul class="highlights">
                {highlights.map((highlight) => <li>{highlight}</li>)}
              </ul>
            )}

            {sections.length > 0 && <div class="editorial-sections">{sections.map((section) => (
              <section><h3>{section.heading}</h3>{Array.isArray(section.body) ? <ul>{section.body.map((line) => <li>{String(line)}</li>)}</ul> : <p>{String(section.body)}</p>}</section>
            ))}</div>}
          </section>

          {(methodsAndGuiding || territory || itinerary.length > 0 || (hunt.secondary_species ?? []).length > 0) && (
            <section class="content-section" id="experience">
              <p class="section-label">In the field</p>
              <h2>The hunting experience</h2>
              {territory?.summary && <p class="section-intro">{String(territory.summary)}</p>}
              <dl class="detail-grid">
                {displayedTechniques.length > 0 && <div><dt>Techniques</dt><dd>{displayedTechniques.join(', ')}</dd></div>}
                {methodsAndGuiding?.guidingRatio && <div><dt>Guiding</dt><dd>{String(methodsAndGuiding.guidingRatio)}</dd></div>}
                {methodsAndGuiding?.intensity && <div><dt>Hunt intensity</dt><dd>{humanize(methodsAndGuiding.intensity)}</dd></div>}
                {methodsAndGuiding?.physicalDifficulty && <div><dt>Physical difficulty</dt><dd>{humanize(methodsAndGuiding.physicalDifficulty)}</dd></div>}
                {methodsAndGuiding?.mobilityNotes && <div class="wide"><dt>Mobility</dt><dd>{String(methodsAndGuiding.mobilityNotes)}</dd></div>}
                {(hunt.secondary_species ?? []).length > 0 && <div class="wide"><dt>Additional species</dt><dd>{hunt.secondary_species.join(', ')}</dd></div>}
                {territorySize && <div><dt>Area</dt><dd>{Number(territorySize.value).toLocaleString('en-US')} {humanize(territorySize.unit)}</dd></div>}
                {territory?.ownership && <div><dt>Land access</dt><dd>{humanize(territory.ownership)}</dd></div>}
                {territory?.fenceStatus && <div><dt>Hunt setting</dt><dd>{humanize(territory.fenceStatus)}</dd></div>}
                {strings(territory?.terrain).length > 0 && <div><dt>Terrain</dt><dd>{strings(territory?.terrain).join(', ')}</dd></div>}
                {accessMethods.length > 0 && <div><dt>Field access</dt><dd>{accessMethods.join(', ')}</dd></div>}
                {territory?.elevation && <div><dt>Elevation</dt><dd>{String(territory.elevation)}</dd></div>}
              </dl>
              {itinerary.length > 0 && <div class="content-subsection"><h3>Typical itinerary</h3><ol class="itinerary">{itinerary.map((item, index) => (
                <li><strong>{String(item.title ?? item.label ?? `Day ${item.day ?? index + 1}`)}</strong>{item.description && <p>{String(item.description)}</p>}</li>
              ))}</ol></div>}
            </section>
          )}

          {season && (
            <section class="content-section" id="timing">
              <p class="section-label">Timing</p>
              <h2>Season and availability</h2>
              <dl class="detail-grid">
                <div><dt>Hunting season</dt><dd>{seasonLabel}</dd></div>
                <div><dt>Availability</dt><dd>{inquiryAvailability}</dd></div>
                {season.peak && <div><dt>Peak period</dt><dd>{String(season.peak)}</dd></div>}
                {season.lastVerifiedAt && <div><dt>Last verified</dt><dd>{new Date(String(season.lastVerifiedAt)).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</dd></div>}
              </dl>
              {records(season.windows).length > 0 && (
                <div class="date-windows">
                  {records(season.windows).map((window) => (
                    <div><strong>{String(window.start)}</strong><span>to {String(window.end)}</span><small>{humanize(window.status)}</small></div>
                  ))}
                </div>
              )}
              <p class="confirmation-note">Dates and availability are published by the outfitter and should be confirmed when you inquire.</p>
            </section>
          )}

          {(accommodations.length > 0 || arrangedAccommodations.length > 0 || airports.length > 0 || travel?.transferTime) && (
            <section class="content-section accommodation-section" id="stay-travel">
              <p class="section-label">Logistics</p>
              <h2>Stay and travel</h2>
              {(accommodations.length > 0 || arrangedAccommodations.length > 0) && <div class="content-subsection"><h3>Accommodation</h3><div class="accommodation-grid">
                {accommodations.map(({ relation, lodge, media: lodgeMedia }) => lodge && (
                  <article class="accommodation-card">
                    {lodgeMedia[0] && <img src={mediaUrl(lodgeMedia[0]) || ''} alt={lodgeMedia[0].alt || lodge.name || ''} loading="lazy" />}
                    <div>
                      <p class="location">{relation.region_name || lodgeRegion(lodge.location) || 'Accommodation'}</p>
                      <h3>{lodge.standalone_page === true ? <a href={`/lodges/${lodge.lodge_id}`}>{lodge.name}</a> : lodge.name}</h3>
                      <p>{relation.summary || lodge.summary}</p>
                      {relation.transfer_notes && <p class="transfer">{relation.transfer_notes}</p>}
                    </div>
                  </article>
                ))}
                {arrangedAccommodations.map((accommodation) => (
                  <article class="accommodation-card arranged-accommodation">
                    <div>
                      <p class="location">{String(accommodation.regionName ?? 'Accommodation')}</p>
                      <h3>{String(accommodation.name ?? accommodation.classification ?? 'Included accommodation')}</h3>
                      <p>{String(accommodation.summary ?? '')}</p>
                      {typeof accommodation.includedNights === 'number' && <p class="transfer">{accommodation.includedNights} nights included</p>}
                      {accommodation.transferNotes && <p class="transfer">{String(accommodation.transferNotes)}</p>}
                    </div>
                  </article>
                ))}
              </div></div>}
              {(airports.length > 0 || travel?.transferTime) && <div class="content-subsection"><h3>Arrival and transfers</h3><div class="travel-grid">
                {airports.map((airport) => (
                  <article><strong>{String(airport.code)}</strong><div><h3>{String(airport.name)}</h3><p>{humanize(airport.type)} airport</p></div></article>
                ))}
              </div>{travel?.transferTime && <p class="confirmation-note"><strong>Typical transfer:</strong> {String(travel.transferTime)}</p>}</div>}
            </section>
          )}

          {(priceOptions.length > 0 || inclusions.length > 0 || exclusions.length > 0 || optionalServices.length > 0) && (
            <section class="content-section" id="package">
              <p class="section-label">Costs and inclusions</p>
              <h2>Package and pricing</h2>
              {priceOptions.length > 0 && <div class="content-subsection"><h3>Pricing options</h3><div class="price-options">{priceOptions.map((option) => (
                <article>
                  <div><h3>{String(option.label)}</h3><p>{priceBasis(option.basis)}</p></div>
                  <strong>{formatPrice(Number(option.amount), String(option.currency ?? hunt.currency))}</strong>
                  {(option.includedHunters || option.includedGuests || option.includedHuntingDays) && <p class="option-details">{[
                    option.includedHunters && countLabel(option.includedHunters, 'hunter'),
                    option.includedGuests && countLabel(option.includedGuests, 'guest'),
                    option.includedHuntingDays && countLabel(option.includedHuntingDays, 'hunting day'),
                  ].filter(Boolean).join(', ')}</p>}
                  {option.notes && <p class="option-details">{String(option.notes)}</p>}
                </article>
              ))}</div>{(pricing?.depositAmount !== undefined || pricing?.depositPercentage !== undefined || pricing?.finalPaymentDueDays !== undefined || strings(pricing?.paymentMethods).length > 0) && <dl class="detail-grid payment-details">
                {pricing?.depositAmount !== undefined && <div><dt>Deposit</dt><dd>{formatPrice(Number(pricing.depositAmount), hunt.currency)}</dd></div>}
                {pricing?.depositPercentage !== undefined && <div><dt>Deposit</dt><dd>{String(pricing.depositPercentage)}%</dd></div>}
                {pricing?.finalPaymentDueDays !== undefined && <div><dt>Final payment</dt><dd>{String(pricing.finalPaymentDueDays)} days before arrival</dd></div>}
                {strings(pricing?.paymentMethods).length > 0 && <div><dt>Payment methods</dt><dd>{strings(pricing?.paymentMethods).join(', ')}</dd></div>}
              </dl>}</div>}
              {(inclusions.length > 0 || exclusions.length > 0) && <div class="content-subsection package-grid">
                {inclusions.length > 0 && <div><h3>Included</h3><ul class="package-list included-list">{inclusions.map((item) => <li>{item}</li>)}</ul></div>}
                {exclusions.length > 0 && <div><h3>Not included</h3><ul class="package-list excluded-list">{exclusions.map((item) => <li>{item}</li>)}</ul></div>}
              </div>}
              {optionalServices.length > 0 && <div class="content-subsection"><h3>Optional services</h3><div class="service-list">
                {optionalServices.map((service) => (
                  <article>
                    <div><h3>{String(service.name ?? service.label ?? service.service ?? 'Optional service')}</h3>{service.description && <p>{String(service.description)}</p>}</div>
                    {service.price !== undefined && <strong>{formatPrice(Number(service.price), String(service.currency ?? hunt.currency))}</strong>}
                    {service.amount !== undefined && <strong>{formatPrice(Number(service.amount), String(service.currency ?? hunt.currency))}</strong>}
                  </article>
                ))}
              </div></div>}
            </section>
          )}

          {equipment && (
            <section class="content-section" id="preparation">
              <p class="section-label">Preparation</p>
              <h2>Equipment and licenses</h2>
              <dl class="detail-grid">
                {displayedEquipment.length > 0 && <div><dt>Primary equipment</dt><dd>{displayedEquipment.join(', ')}</dd></div>}
                <div><dt>Hunting license</dt><dd>{equipment.licenseRequired ? 'Required' : 'Not required'}</dd></div>
                {equipment.licenseCost !== undefined && <div><dt>License cost</dt><dd>{formatPrice(Number(equipment.licenseCost), hunt.currency)}</dd></div>}
                {equipment.licenseArrangement && <div class="wide"><dt>License arrangements</dt><dd>{String(equipment.licenseArrangement)}</dd></div>}
                {gunRental && <div><dt>Firearm rental</dt><dd>{gunRental.available === false ? 'Not available' : gunRental.cost ? formatPrice(Number(gunRental.cost), String(gunRental.currency ?? hunt.currency)) : 'Available'}</dd></div>}
                {gunRental && strings(gunRental.gauges).length > 0 && <div><dt>Available options</dt><dd>{strings(gunRental.gauges).join(', ')}</dd></div>}
                {gunRental?.notes && <div class="wide"><dt>Rental details</dt><dd>{String(gunRental.notes)}</dd></div>}
              </dl>
            </section>
          )}

          {(faqs.length > 0 || terms) && (
            <section class="content-section" id="terms">
              <p class="section-label">Before you book</p>
              <h2>Terms and questions</h2>
              {faqs.length > 0 && <div class="content-subsection"><h3>Common questions</h3><div class="faqs">
                {faqs.map((item) => (
                  <details>
                    <summary>{String(item.question ?? '')}</summary>
                    <p>{String(item.answer ?? '')}</p>
                  </details>
                ))}
              </div></div>}
              {terms && <div class="content-subsection"><h3>Booking policies</h3><div class="faqs">
                {terms.cancellationPolicy && <details><summary>Cancellation policy</summary><p>{String(terms.cancellationPolicy)}</p></details>}
                {terms.trophyFeePolicy && <details><summary>Trophy fee policy</summary><p>{String(terms.trophyFeePolicy)}</p></details>}
                {terms.woundingPolicy && <details><summary>Wounding policy</summary><p>{String(terms.woundingPolicy)}</p></details>}
              </div></div>}
            </section>
          )}

          {relatedHunts.length > 0 && (
            <section class="content-section related-section">
              <p class="section-label">Keep comparing</p>
              <h2>Related hunts</h2>
              <div class="related-grid">
                {relatedHunts.map(({ hunt: related, media: relatedMedia }) => (
                  <a href={`/hunts/${related.listing_id}`}>
                    {relatedMedia && <img src={mediaUrl(relatedMedia) || ''} alt={relatedMedia.alt || related.title || ''} loading="lazy" />}
                    <div><p>{destinationLabel(huntDestinations(related.destinations))}</p><h3>{related.title}</h3><strong>{formatPrice(related.starting_price, related.currency)}</strong></div>
                  </a>
                ))}
              </div>
            </section>
          )}
        </article>

        <aside id="inquiry">
          <p class="price-label">Starting price</p>
          <p class="price">{formatPrice(hunt.starting_price, hunt.currency)}</p>
          {priceOptions[0]?.basis && <p class="price-basis">{priceBasis(priceOptions[0].basis)}</p>}
          {!directInquiry && <p>{hunt.outfitter_name} handles inquiries on its own website.</p>}
          {directInquiry ? (
            <form class="inquiry-form" data-inquiry-form data-endpoint={String(directInquiry.submissionUrl)} data-listing-id={hunt.listing_id} data-inquiry-rules={inquiryRules ? JSON.stringify(inquiryRules) : undefined}>
              <h2>Ask {hunt.outfitter_name} about this hunt</h2>
              <p class="form-routing">Dates, pricing questions, and special requests are delivered to the outfitter.</p>
              <label><span>Name</span><input name="name" autocomplete="name" required /></label>
              <label><span>Email</span><input name="email" type="email" autocomplete="email" required /></label>
              <label><span>Phone</span><input name="phone" type="tel" autocomplete="tel" required /></label>
              <div class="date-range-field" data-date-range-picker>
                <span class="date-range-label" id="preferred-dates-label">Preferred dates</span>
                <button class="date-range-trigger" type="button" data-date-range-trigger aria-labelledby="preferred-dates-label" aria-haspopup="dialog" aria-expanded="false">
                  <span><small>Start</small><b data-start-display>Select date</b></span>
                  <i aria-hidden="true">→</i>
                  <span><small>End</small><b data-end-display>Select date</b></span>
                </button>
                <input name="from_date" type="hidden" data-inquiry-start />
                <input name="to_date" type="hidden" data-inquiry-end />
                <dialog class="date-range-dialog" data-date-range-dialog aria-labelledby="date-range-title">
                  <div class="date-range-dialog-inner">
                    <header>
                      <div><p id="date-range-title">Select preferred dates</p><span data-date-instruction>Choose a start date</span></div>
                      <button type="button" data-date-close aria-label="Close date picker">×</button>
                    </header>
                    <div class="date-range-selection" aria-live="polite">
                      <span><small>Start</small><strong data-dialog-start>Not selected</strong></span>
                      <i aria-hidden="true">→</i>
                      <span><small>End</small><strong data-dialog-end>Not selected</strong></span>
                    </div>
                    <div class="date-range-navigation">
                      <button type="button" data-month-previous aria-label="Previous month">‹</button>
                      <span class="sr-only" data-calendar-announcement aria-live="polite"></span>
                      <button type="button" data-month-next aria-label="Next month">›</button>
                    </div>
                    <div class="date-range-calendars" data-date-calendars></div>
                    <p class="date-dialog-error" data-date-dialog-error aria-live="polite" hidden></p>
                    <footer>
                      <button type="button" class="date-clear" data-date-clear>Clear</button>
                      <button type="button" class="primary" data-date-apply disabled>Apply dates</button>
                    </footer>
                  </div>
                </dialog>
              </div>
              <p class="date-error" data-date-error aria-live="polite" hidden></p>
              <div class="form-row">
                <label><span>Hunters</span><input name="num_hunters" type="number" min="1" value="1" required /></label>
                <label><span>Non-hunters</span><input name="num_non_hunters" type="number" min="0" value="0" /></label>
              </div>
              <label><span>Questions or requests</span><textarea name="special_requests" rows="4"></textarea></label>
              <label class="website-field" aria-hidden="true"><span>Website</span><input name="website" tabindex="-1" autocomplete="off" /></label>
              <button class="primary" type="submit">Send inquiry</button>
              <p class="form-status" data-inquiry-status aria-live="polite"></p>
            </form>
          ) : (
            <a class="primary" href={hunt.outfitter_inquiry_url || hunt.source_url || '#'}>Continue to outfitter site</a>
          )}
          {directInquiry && <a class="secondary" href={hunt.source_url || '#'}>View on outfitter site</a>}
        </aside>
      </section>

      <a class="mobile-inquiry-bar" data-mobile-trip-action href="#inquiry"><span><small>Starting from</small><strong>{formatPrice(hunt.starting_price, hunt.currency)}</strong></span><b>{inquiryActionLabel}</b></a>

      {galleryMedia.length > 0 && (
        <dialog class="gallery-dialog" data-gallery-dialog aria-label={`${hunt.title} photo gallery`}>
          <button class="gallery-close" type="button" data-gallery-close aria-label="Close gallery">×</button>
          <button class="gallery-previous" type="button" data-gallery-previous aria-label="Previous photo">‹</button>
          <figure><img data-gallery-image src={mediaUrl(galleryMedia[0]) || ''} alt={galleryMedia[0].alt || hunt.title || ''} /><figcaption><span data-gallery-caption>{galleryMedia[0].caption || galleryMedia[0].alt}</span><small data-gallery-counter>1 / {galleryMedia.length}</small></figcaption></figure>
          <button class="gallery-next" type="button" data-gallery-next aria-label="Next photo">›</button>
        </dialog>
      )}
      <script type="application/json" id="hunt-gallery-data" set:html={JSON.stringify(galleryMedia.map((item) => ({ src: mediaUrl(item), alt: item.alt || hunt.title, caption: item.caption || item.alt || '' })))} />
    </>
  ) : (
    <section class="container not-found">
      <p class="eyebrow">Not found</p>
      <h1>This hunt is not currently listed.</h1>
      <p>It may have been paused or removed by the participating outfitter.</p>
      <a href="/#hunts">Browse available hunts</a>
    </section>
  )}
</BaseLayout>

<script>
  import {
    inquiryCalendarBounds,
    isInquiryDateAvailable,
    isInquiryRangeAvailable,
    shiftIsoDate,
  } from '../../lib/inquiry-date-range';

  const inquiryForm = document.querySelector<HTMLFormElement>('[data-inquiry-form]');
  if (inquiryForm) {
    const startInput = inquiryForm.querySelector<HTMLInputElement>('[data-inquiry-start]');
    const endInput = inquiryForm.querySelector<HTMLInputElement>('[data-inquiry-end]');
    const picker = inquiryForm.querySelector<HTMLElement>('[data-date-range-picker]');
    const trigger = picker?.querySelector<HTMLButtonElement>('[data-date-range-trigger]');
    const dialog = picker?.querySelector<HTMLDialogElement>('[data-date-range-dialog]');
    const dateError = inquiryForm.querySelector<HTMLElement>('[data-date-error]');
    const rules = inquiryForm.dataset.inquiryRules
      ? JSON.parse(inquiryForm.dataset.inquiryRules) as { years: Array<{ year: number; mode: 'allow' | 'block' }>; dates: string[] }
      : null;
    const localDate = new Date();
    const today = `${localDate.getFullYear()}-${String(localDate.getMonth() + 1).padStart(2, '0')}-${String(localDate.getDate()).padStart(2, '0')}`;
    const calendarBounds = rules ? inquiryCalendarBounds(rules, today) : null;
    const allowedDate = (date: string) => isInquiryDateAvailable(date, rules, today);
    const allowedRange = (start: string, end: string) => isInquiryRangeAvailable(start, end, rules, today);
    const formatDate = (date: string) => date
      ? new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${date}T00:00:00Z`))
      : '';
    const validateDates = (showIncomplete = false) => {
      if (!startInput || !endInput) return true;
      const complete = Boolean(startInput.value && endInput.value);
      const valid = complete && allowedRange(startInput.value, endInput.value);
      const message = !complete && showIncomplete
        ? 'Select both a preferred start and end date.'
        : complete && !valid
          ? 'Choose a future range where every date is open for inquiries.'
          : '';
      startInput.setCustomValidity(message);
      endInput.setCustomValidity(message);
      trigger?.setAttribute('aria-invalid', message ? 'true' : 'false');
      if (dateError) {
        dateError.textContent = message;
        dateError.hidden = !message;
      }
      return complete && valid;
    };

    if (picker && trigger && dialog && startInput && endInput) {
      const calendars = dialog.querySelector<HTMLElement>('[data-date-calendars]');
      const startDisplay = picker.querySelector<HTMLElement>('[data-start-display]');
      const endDisplay = picker.querySelector<HTMLElement>('[data-end-display]');
      const dialogStart = dialog.querySelector<HTMLElement>('[data-dialog-start]');
      const dialogEnd = dialog.querySelector<HTMLElement>('[data-dialog-end]');
      const instruction = dialog.querySelector<HTMLElement>('[data-date-instruction]');
      const announcement = dialog.querySelector<HTMLElement>('[data-calendar-announcement]');
      const dialogError = dialog.querySelector<HTMLElement>('[data-date-dialog-error]');
      const applyButton = dialog.querySelector<HTMLButtonElement>('[data-date-apply]');
      const previousButton = dialog.querySelector<HTMLButtonElement>('[data-month-previous]');
      const nextButton = dialog.querySelector<HTMLButtonElement>('[data-month-next]');
      const minimum = calendarBounds?.minimum || today;
      const maximum = calendarBounds?.maximum || shiftIsoDate(today, 1095);
      let draftStart = '';
      let draftEnd = '';
      let visibleMonth = new Date(`${minimum.slice(0, 7)}-01T00:00:00Z`);
      const compactCalendar = () => !window.matchMedia('(min-width: 720px)').matches;
      const monthIso = (date: Date) => date.toISOString().slice(0, 7);
      const moveMonth = (date: Date, offset: number) => new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth() + offset, 1));

      const updateSelection = () => {
        if (startDisplay) startDisplay.textContent = draftStart ? formatDate(draftStart) : 'Select date';
        if (endDisplay) endDisplay.textContent = draftEnd ? formatDate(draftEnd) : 'Select date';
        if (dialogStart) dialogStart.textContent = draftStart ? formatDate(draftStart) : 'Not selected';
        if (dialogEnd) dialogEnd.textContent = draftEnd ? formatDate(draftEnd) : 'Not selected';
        if (instruction) instruction.textContent = draftStart && !draftEnd ? 'Now choose an end date' : draftStart ? 'Review or change your dates' : 'Choose a start date';
        if (applyButton) applyButton.disabled = !allowedRange(draftStart, draftEnd);
      };

      const renderCalendars = () => {
        if (!calendars) return;
        calendars.replaceChildren();
        const monthCount = compactCalendar() ? 1 : 2;
        for (let monthOffset = 0; monthOffset < monthCount; monthOffset += 1) {
          const month = moveMonth(visibleMonth, monthOffset);
          const section = document.createElement('section');
          section.className = 'date-calendar';
          const heading = document.createElement('h3');
          heading.textContent = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(month);
          section.append(heading);
          const weekdays = document.createElement('div');
          weekdays.className = 'date-weekdays';
          ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].forEach((day) => {
            const label = document.createElement('span');
            label.textContent = day.slice(0, 1);
            label.setAttribute('aria-label', day);
            weekdays.append(label);
          });
          section.append(weekdays);
          const grid = document.createElement('div');
          grid.className = 'date-days';
          grid.setAttribute('role', 'grid');
          grid.setAttribute('aria-label', heading.textContent);
          const firstWeekday = month.getUTCDay();
          for (let blank = 0; blank < firstWeekday; blank += 1) grid.append(document.createElement('span'));
          const daysInMonth = new Date(Date.UTC(month.getUTCFullYear(), month.getUTCMonth() + 1, 0)).getUTCDate();
          for (let day = 1; day <= daysInMonth; day += 1) {
            const date = `${monthIso(month)}-${String(day).padStart(2, '0')}`;
            const button = document.createElement('button');
            button.type = 'button';
            button.textContent = String(day);
            button.dataset.calendarDate = date;
            button.setAttribute('role', 'gridcell');
            button.setAttribute('aria-label', formatDate(date));
            button.disabled = !allowedDate(date);
            button.tabIndex = date === draftStart || (!draftStart && date === minimum) ? 0 : -1;
            if (date === draftStart) button.classList.add('range-start');
            if (date === draftEnd) button.classList.add('range-end');
            if (draftStart && draftEnd && date > draftStart && date < draftEnd) button.classList.add('in-range');
            if (date === draftStart || date === draftEnd) button.setAttribute('aria-selected', 'true');
            button.addEventListener('click', () => {
              if (!draftStart || draftEnd || date <= draftStart) {
                draftStart = date;
                draftEnd = '';
                if (dialogError) dialogError.hidden = true;
              } else if (allowedRange(draftStart, date)) {
                draftEnd = date;
                if (dialogError) dialogError.hidden = true;
              } else if (dialogError) {
                dialogError.textContent = 'That range includes dates the outfitter has not opened for inquiries.';
                dialogError.hidden = false;
              }
              updateSelection();
              renderCalendars();
            });
            grid.append(button);
          }
          grid.addEventListener('keydown', (event) => {
            const current = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-calendar-date]');
            if (!current) return;
            const offsets: Record<string, number> = { ArrowLeft: -1, ArrowRight: 1, ArrowUp: -7, ArrowDown: 7 };
            const offset = offsets[event.key];
            if (!offset) return;
            event.preventDefault();
            const targetDate = shiftIsoDate(current.dataset.calendarDate || '', offset);
            const targetMonth = targetDate.slice(0, 7);
            if (targetMonth < monthIso(visibleMonth) || targetMonth > monthIso(moveMonth(visibleMonth, monthCount - 1))) {
              visibleMonth = new Date(`${targetMonth}-01T00:00:00Z`);
              renderCalendars();
            }
            dialog.querySelector<HTMLButtonElement>(`[data-calendar-date="${targetDate}"]:not(:disabled)`)?.focus();
          });
          section.append(grid);
          calendars.append(section);
        }
        const lastVisibleMonth = moveMonth(visibleMonth, monthCount - 1);
        if (previousButton) previousButton.disabled = monthIso(visibleMonth) <= minimum.slice(0, 7);
        if (nextButton) nextButton.disabled = monthIso(lastVisibleMonth) >= maximum.slice(0, 7);
        if (announcement) announcement.textContent = [...calendars.querySelectorAll('h3')].map((item) => item.textContent).join(' and ');
      };

      const openPicker = () => {
        draftStart = startInput.value;
        draftEnd = endInput.value;
        visibleMonth = new Date(`${(draftStart || minimum).slice(0, 7)}-01T00:00:00Z`);
        updateSelection();
        renderCalendars();
        trigger.setAttribute('aria-expanded', 'true');
        dialog.showModal();
        requestAnimationFrame(() => {
          const preferredDate = draftStart || minimum;
          dialog.querySelector<HTMLButtonElement>(`[data-calendar-date="${preferredDate}"]:not(:disabled)`)?.focus();
        });
      };
      const closePicker = () => dialog.close();
      trigger.addEventListener('click', openPicker);
      dialog.querySelector('[data-date-close]')?.addEventListener('click', closePicker);
      dialog.addEventListener('close', () => {
        trigger.setAttribute('aria-expanded', 'false');
        trigger.focus();
      });
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) closePicker();
      });
      previousButton?.addEventListener('click', () => { visibleMonth = moveMonth(visibleMonth, -1); renderCalendars(); });
      nextButton?.addEventListener('click', () => { visibleMonth = moveMonth(visibleMonth, 1); renderCalendars(); });
      dialog.querySelector('[data-date-clear]')?.addEventListener('click', () => {
        draftStart = '';
        draftEnd = '';
        updateSelection();
        renderCalendars();
      });
      applyButton?.addEventListener('click', () => {
        startInput.value = draftStart;
        endInput.value = draftEnd;
        updateSelection();
        validateDates();
        closePicker();
      });
      window.matchMedia('(min-width: 720px)').addEventListener('change', () => dialog.open && renderCalendars());
      inquiryForm.addEventListener('inquiry-date-range-reset', () => {
        draftStart = '';
        draftEnd = '';
        updateSelection();
      });
      updateSelection();
    }
    validateDates();

    inquiryForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!validateDates(true)) {
        trigger?.focus();
        return;
      }
      const status = inquiryForm.querySelector<HTMLElement>('[data-inquiry-status]');
      const button = inquiryForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      const values = Object.fromEntries(new FormData(inquiryForm));
      if (status) status.textContent = 'Sending your inquiry...';
      if (button) button.disabled = true;
      try {
        const response = await fetch(inquiryForm.dataset.endpoint || '', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Idempotency-Key': crypto.randomUUID(),
          },
          body: JSON.stringify({
            ...values,
            listing_id: inquiryForm.dataset.listingId,
            referral_url: window.location.href,
          }),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.success) throw new Error(result.message || result.error || 'Unable to send inquiry');
        inquiryForm.reset();
        inquiryForm.dispatchEvent(new Event('inquiry-date-range-reset'));
        validateDates();
        if (status) status.textContent = result.booking_reference
          ? `Your inquiry was sent. Reference ${result.booking_reference}.`
          : 'Your inquiry was sent.';
      } catch (error) {
        if (status) status.textContent = error instanceof Error
          ? `${error.message}. You can also contact the outfitter through its website.`
          : 'Unable to send inquiry. Please use the outfitter website.';
      } finally {
        if (button) button.disabled = false;
      }
    });
  }

  const galleryDialog = document.querySelector<HTMLDialogElement>('[data-gallery-dialog]');
  const galleryDataElement = document.querySelector<HTMLScriptElement>('#hunt-gallery-data');
  if (galleryDialog && galleryDataElement) {
    const galleryItems = JSON.parse(galleryDataElement.textContent || '[]') as Array<{ src: string; alt: string; caption: string }>;
    const galleryImage = galleryDialog.querySelector<HTMLImageElement>('[data-gallery-image]');
    const galleryCaption = galleryDialog.querySelector<HTMLElement>('[data-gallery-caption]');
    const galleryCounter = galleryDialog.querySelector<HTMLElement>('[data-gallery-counter]');
    let galleryIndex = 0;

    const renderGalleryItem = () => {
      const item = galleryItems[galleryIndex];
      if (!item) return;
      if (galleryImage) {
        galleryImage.src = item.src;
        galleryImage.alt = item.alt;
      }
      if (galleryCaption) galleryCaption.textContent = item.caption;
      if (galleryCounter) galleryCounter.textContent = `${galleryIndex + 1} / ${galleryItems.length}`;
    };
    const moveGallery = (direction: number) => {
      galleryIndex = (galleryIndex + direction + galleryItems.length) % galleryItems.length;
      renderGalleryItem();
    };

    document.querySelectorAll<HTMLButtonElement>('[data-gallery-index]').forEach((button) => {
      button.addEventListener('click', () => {
        galleryIndex = Number(button.dataset.galleryIndex || 0);
        renderGalleryItem();
        galleryDialog.showModal();
      });
    });
    galleryDialog.querySelector('[data-gallery-close]')?.addEventListener('click', () => galleryDialog.close());
    galleryDialog.querySelector('[data-gallery-previous]')?.addEventListener('click', () => moveGallery(-1));
    galleryDialog.querySelector('[data-gallery-next]')?.addEventListener('click', () => moveGallery(1));
    galleryDialog.addEventListener('click', (event) => {
      if (event.target === galleryDialog) galleryDialog.close();
    });
    document.addEventListener('keydown', (event) => {
      if (!galleryDialog.open) return;
      if (event.key === 'ArrowLeft') moveGallery(-1);
      if (event.key === 'ArrowRight') moveGallery(1);
    });
  }

  const sectionLinks = [...document.querySelectorAll<HTMLAnchorElement>('.detail-nav-links a')];
  const observedSections = sectionLinks
    .map((link) => document.querySelector<HTMLElement>(link.hash))
    .filter((section): section is HTMLElement => Boolean(section));
  if (sectionLinks.length > 0 && observedSections.length > 0) {
    const setCurrentSection = (id: string) => {
      sectionLinks.forEach((link) => {
        if (link.hash === `#${id}`) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };
    const sectionObserver = new IntersectionObserver((entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((left, right) => right.intersectionRatio - left.intersectionRatio)[0];
      if (visible?.target.id) setCurrentSection(visible.target.id);
    }, { rootMargin: '-18% 0px -62% 0px', threshold: [0, .15, .4] });
    observedSections.forEach((section) => sectionObserver.observe(section));
  }

  const inlineTripAction = document.querySelector<HTMLElement>('[data-inline-trip-action]');
  const mobileTripAction = document.querySelector<HTMLElement>('[data-mobile-trip-action]');
  if (inlineTripAction && mobileTripAction) {
    const actionObserver = new IntersectionObserver(([entry]) => {
      mobileTripAction.classList.toggle('is-visible', !entry.isIntersecting && entry.boundingClientRect.top < 0);
    }, { threshold: 0 });
    actionObserver.observe(inlineTripAction);
  }
</script>

<style>
  .detail-hero {
    position: relative;
    min-height: 560px;
    display: grid;
    align-items: end;
    isolation: isolate;
    background: var(--dark) var(--hero-image) center / cover no-repeat;
    color: #fff;
  }

  .shade {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(0deg, rgba(7, 12, 8, 0.9), rgba(7, 12, 8, 0.12) 76%);
  }

  .hero-inner {
    padding-bottom: 64px;
  }

  .back {
    display: inline-block;
    margin-bottom: 100px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.9rem;
  }

  .location,
  .eyebrow {
    margin: 0 0 12px;
    color: #e6bd7d;
    font-size: 0.76rem;
    font-weight: 750;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .location a {
    color: inherit;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1,
  h2 {
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 500;
    letter-spacing: -0.035em;
  }

  h1 {
    max-width: 900px;
    margin-bottom: 12px;
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 0.96;
  }

  .outfitter {
    margin-bottom: 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 1.05rem;
  }

  .detail-layout {
