---
import BaseLayout from '../layouts/BaseLayout.astro';
import HuntCard from '../components/HuntCard.astro';
import { loadCatalogSnapshot, mediaUrl } from '../lib/catalog-build';
import { publicSlug } from '../lib/public-slugs';

export const prerender = true;

const catalog = await loadCatalogSnapshot();
const allHunts = catalog.hunts;
const allMedia = catalog.huntMedia;
const outfitters = catalog.outfitters;

const countries = [...new Set(allHunts.map((hunt) => hunt.country).filter(Boolean))].sort();
const speciesOptions = [...new Set(allHunts.flatMap((hunt) => hunt.primary_species ?? []))].sort();
const regions = [...new Set(allHunts.map((hunt) => hunt.region).filter(Boolean))].sort();
const tripTypes = [...new Set(allHunts.map((hunt) => hunt.trip_type).filter(Boolean))].sort();
const record = (value: unknown): Record<string, unknown> | null => value && typeof value === 'object' && !Array.isArray(value) ? value as Record<string, unknown> : null;
const records = (value: unknown): Array<Record<string, unknown>> => Array.isArray(value) ? value.filter((item) => record(item)).map((item) => item as Record<string, unknown>) : [];
const humanize = (value: unknown) => String(value ?? '').replaceAll('-', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());
const huntMethods = (hunt: (typeof allHunts)[number]) => records(record(hunt.classification)?.methods)
  .map((method) => String(method.name ?? method.key ?? ''))
  .filter(Boolean);
const methods = [...new Set(allHunts.flatMap(huntMethods))].sort();
const destinationGroups = countries.map((country) => ({
  country,
  regions: [...new Set(allHunts.filter((hunt) => hunt.country === country).map((hunt) => hunt.region).filter(Boolean))].sort(),
}));
const destinationLinks = regions.map((region) => {
  const country = allHunts.find((hunt) => hunt.region === region)?.country ?? '';
  return { name: region, country, href: `/destinations/${publicSlug(`${region}-${country}`)}` };
});

const mediaByHunt = new Map<string, (typeof allMedia)[number]>();
const mediaCountByHunt = new Map<string, number>();
for (const media of allMedia) {
  if (media.hunt_id && !mediaByHunt.has(media.hunt_id)) mediaByHunt.set(media.hunt_id, media);
  if (media.hunt_id) mediaCountByHunt.set(media.hunt_id, (mediaCountByHunt.get(media.hunt_id) ?? 0) + 1);
}

const imageUrl = (huntId: string | null) => {
  if (!huntId) return null;
  const media = mediaByHunt.get(huntId);
  return mediaUrl(media);
};

const formatPrice = (amount: number | null, currency: string | null) => {
  if (amount === null) return 'Contact for price';
  return `From ${new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: currency || 'USD',
    maximumFractionDigits: 0,
  }).format(amount)}`;
};

const featuredImage = imageUrl(allHunts[0]?.id ?? null);
const searchData = allHunts.map((hunt) => ({
  id: hunt.listing_id,
  sourceId: hunt.source_id,
  search: [hunt.title, hunt.summary, hunt.outfitter_name, hunt.country, hunt.region, ...(hunt.primary_species ?? []), ...(hunt.secondary_species ?? []), ...huntMethods(hunt)]
    .filter(Boolean)
    .join(' ')
    .toLocaleLowerCase(),
  country: hunt.country ?? '',
  region: hunt.region ?? '',
  species: [...(hunt.primary_species ?? []), ...(hunt.secondary_species ?? [])],
  tripType: hunt.trip_type ?? '',
  methods: huntMethods(hunt),
  price: hunt.starting_price,
  huntingDays: Number(record(hunt.duration_and_party ?? hunt.duration)?.huntingDays ?? 0),
}));
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Guided hunting trips',
  description: 'Compare guided hunting trips published directly by participating outfitters.',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: allHunts.length,
    itemListElement: allHunts.map((hunt, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(`/hunts/${hunt.listing_id}`, Astro.site ?? Astro.url.origin).toString(),
      name: hunt.title,
    })),
  },
};
---

<BaseLayout
  title="HuntSeeker | Guided hunting trips from independent outfitters"
  description="Compare guided hunting trips published directly by participating outfitters."
  image={featuredImage}
  structuredData={collectionSchema}
>
  <section class="hero" style={featuredImage ? `--hero-image: url('${featuredImage}')` : undefined}>
    <div class="hero-shade"></div>
    <div class="container hero-content">
      <p class="eyebrow">Hunts from independent outfitters</p>
      <h1>Find the hunt that fits how you want to travel.</h1>
      <p>
        Compare destinations, species, dates, and package details published by the outfitters who run each trip.
      </p>
      <a class="hero-link" href="#hunts">Explore {allHunts.length} hunts</a>
    </div>
  </section>

  <nav class="browse-links wide-container" aria-label="Browse hunts by destination or species">
    <div><span>Destinations</span>{destinationLinks.map((item) => <a href={item.href}>{item.name}</a>)}</div>
    <div><span>Species</span>{speciesOptions.map((item) => <a href={`/species/${publicSlug(item)}`}>{item}</a>)}</div>
  </nav>

  <section class="catalog wide-container" id="hunts">
    <div class="catalog-heading">
      <div>
        <p class="eyebrow dark">Browse the current collection</p>
        <h2>Guided hunts</h2>
      </div>
      <div class="catalog-actions">
        <p class="result-count" aria-live="polite"><span data-result-count>{allHunts.length}</span> <span data-result-label>{allHunts.length === 1 ? 'hunt' : 'hunts'}</span></p>
        <button class="filter-open" type="button" data-filter-open>Filters <span data-active-count hidden>0</span></button>
      </div>
    </div>

    <div class="filter-backdrop" data-filter-backdrop></div>
    <div class="catalog-layout">
      <aside class="filter-panel" data-filter-panel aria-label="Filter hunts">
        <form class="filters" method="get" action="/#hunts">
          <div class="filter-header"><div><p>Refine results</p><strong>Find the right hunt</strong></div><button type="button" data-filter-close aria-label="Close filters">×</button></div>
          <label class="search-field"><span>Search hunts</span><input name="q" type="search" placeholder="Species, region, or outfitter" autocomplete="off" /></label>
          <details open>
            <summary>Destination</summary>
            <div class="filter-group facet-options">
              {destinationGroups.map((group) => (
                <div class="destination-group">
                  <label class="check-option destination-parent" data-facet-option>
                    <input type="checkbox" name="country" value={group.country} data-facet="destination" data-label={group.country} />
                    <span>{group.country}</span>
                    <small data-facet-count data-facet="destination" data-value={group.country}>{allHunts.filter((hunt) => hunt.country === group.country).length}</small>
                  </label>
                  <div class="destination-children">
                    {group.regions.map((region) => (
                      <label class="check-option" data-facet-option>
                        <input type="checkbox" name="region" value={region} data-facet="destination" data-label={region} />
                        <span>{region}</span>
                        <small data-facet-count data-facet="destination" data-value={region}>{allHunts.filter((hunt) => hunt.region === region).length}</small>
                      </label>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </details>
          <details open>
            <summary>Species</summary>
            <div class="filter-group">
              {speciesOptions.length > 7 && <label class="facet-search"><span>Find a species</span><input type="search" placeholder="Search species" autocomplete="off" data-facet-search="species" /></label>}
              <div class="facet-options" data-facet-list="species">
                {speciesOptions.map((item) => (
                  <label class="check-option" data-facet-option>
                    <input type="checkbox" name="species" value={item} data-facet="species" data-label={item} />
                    <span>{item}</span>
                    <small data-facet-count data-facet="species" data-value={item}>{allHunts.filter((hunt) => [...(hunt.primary_species ?? []), ...(hunt.secondary_species ?? [])].includes(item)).length}</small>
                  </label>
                ))}
              </div>
              <label class="species-mode" data-species-mode hidden>
                <input type="checkbox" name="speciesMode" value="all" />
                <span>Only hunts including every selected species</span>
              </label>
            </div>
          </details>
          <details>
            <summary>Hunt type</summary>
            <div class="filter-group facet-options">
              {tripTypes.map((item) => (
                <label class="check-option" data-facet-option>
                  <input type="checkbox" name="tripType" value={item} data-facet="tripType" data-label={humanize(item)} />
                  <span>{humanize(item)}</span>
                  <small data-facet-count data-facet="tripType" data-value={item}>{allHunts.filter((hunt) => hunt.trip_type === item).length}</small>
                </label>
              ))}
            </div>
          </details>
          <details>
            <summary>Hunting method</summary>
            <div class="filter-group">
              {methods.length > 7 && <label class="facet-search"><span>Find a method</span><input type="search" placeholder="Search methods" autocomplete="off" data-facet-search="method" /></label>}
              <div class="facet-options" data-facet-list="method">
                {methods.map((item) => (
                  <label class="check-option" data-facet-option>
                    <input type="checkbox" name="method" value={item} data-facet="method" data-label={item} />
                    <span>{item}</span>
                    <small data-facet-count data-facet="method" data-value={item}>{allHunts.filter((hunt) => huntMethods(hunt).includes(item)).length}</small>
                  </label>
                ))}
              </div>
            </div>
          </details>
          <details>
            <summary>Budget and trip length</summary>
            <div class="filter-group">
              <label><span>Maximum starting price</span><select name="maxPrice"><option value="">Any price</option><option value="2000">Up to $2,000</option><option value="4000">Up to $4,000</option><option value="7000">Up to $7,000</option><option value="10000">Up to $10,000</option></select></label>
              <label><span>Minimum hunting days</span><select name="minDays"><option value="">Any length</option><option value="2">2 or more days</option><option value="3">3 or more days</option><option value="5">5 or more days</option></select></label>
            </div>
          </details>
          <div class="filter-footer"><button class="apply-filters" type="submit">Show <span data-draft-count>{allHunts.length}</span> hunts</button><button class="clear" type="button" data-clear hidden>Clear all</button></div>
        </form>
      </aside>

      <div class="results-column">
        <div class="results-toolbar"><div class="active-filters" data-active-filters></div><p>Prices and availability are confirmed by each outfitter.</p></div>
        <div class="hunt-grid">
          {allHunts.map((hunt, index) => <HuntCard hunt={hunt} media={hunt.id ? mediaByHunt.get(hunt.id) : undefined} mediaCount={hunt.id ? mediaCountByHunt.get(hunt.id) : 0} eager={index < 2} />)}
        </div>
        <div class="empty" data-empty hidden><h3>No hunts match those filters.</h3><p>Try another species, destination, or search term.</p><button type="button" data-clear>See all hunts</button></div>
      </div>
    </div>
  </section>

  <section class="outfitters" id="outfitters">
    <div class="container outfitters-inner">
      <div>
        <p class="eyebrow">Participating outfitters</p>
        <h2>Published by the people who run the hunt.</h2>
      </div>
      <div class="outfitter-list">
        {(outfitters ?? []).map((outfitter) => (
          <a data-marketplace-source={outfitter.source_id} href={outfitter.public_id ? `/outfitters/${outfitter.public_id}` : outfitter.profile_url || '#'}>
            <strong>{outfitter.name}</strong>
            <span>{outfitter.tagline}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script type="application/json" id="catalog-search-data" set:html={JSON.stringify(searchData)} />
<script>
  import {
    contextualFacetCount,
    emptyFacetState,
    facetStateFromParams,
    facetStateToParams,
    filterFacetRecords,
    type CategoricalFacet,
    type FacetRecord,
    type FacetState,
  } from '../lib/facet-engine';

  const form = document.querySelector<HTMLFormElement>('.filters');
  const dataElement = document.querySelector<HTMLScriptElement>('#catalog-search-data');
  const cards = new Map(
    [...document.querySelectorAll<HTMLElement>('[data-listing-id]')].map((card) => [card.dataset.listingId, card])
  );
  const count = document.querySelector<HTMLElement>('[data-result-count]');
  const resultLabel = document.querySelector<HTMLElement>('[data-result-label]');
  const draftCount = document.querySelector<HTMLElement>('[data-draft-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const panel = document.querySelector<HTMLElement>('[data-filter-panel]');
  const backdrop = document.querySelector<HTMLElement>('[data-filter-backdrop]');
  const openButton = document.querySelector<HTMLButtonElement>('[data-filter-open]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-filter-close]');
  const activeFilters = document.querySelector<HTMLElement>('[data-active-filters]');
  const activeCount = document.querySelector<HTMLElement>('[data-active-count]');
  const mobileQuery = window.matchMedia('(max-width: 900px)');

  if (form && dataElement) {
    const records = JSON.parse(dataElement.textContent || '[]') as FacetRecord[];
    const inactiveSources = (window as Window & { __MARKETPLACE_INACTIVE_SOURCES__?: string[] }).__MARKETPLACE_INACTIVE_SOURCES__ ?? [];
    let committedState = facetStateFromParams(new URLSearchParams(window.location.search));

    const checkedValues = (name: string) => [...form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)].map((input) => input.value);
    const stateFromForm = (): FacetState => {
      const species = checkedValues('species');
      return {
        q: (form.elements.namedItem('q') as HTMLInputElement).value,
        countries: checkedValues('country'),
        regions: checkedValues('region'),
        species,
        speciesMode: species.length > 1 && (form.elements.namedItem('speciesMode') as HTMLInputElement).checked ? 'all' : 'any',
        tripTypes: checkedValues('tripType'),
        methods: checkedValues('method'),
        maxPrice: Number((form.elements.namedItem('maxPrice') as HTMLSelectElement).value || 0),
        minDays: Number((form.elements.namedItem('minDays') as HTMLSelectElement).value || 0),
      };
    };

    const setCheckboxes = (name: string, values: string[]) => {
      form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`).forEach((input) => {
        input.checked = values.includes(input.value);
      });
    };

    const writeStateToForm = (state: FacetState) => {
      (form.elements.namedItem('q') as HTMLInputElement).value = state.q;
      setCheckboxes('country', state.countries);
      setCheckboxes('region', state.regions);
      setCheckboxes('species', state.species);
      setCheckboxes('tripType', state.tripTypes);
      setCheckboxes('method', state.methods);
      (form.elements.namedItem('speciesMode') as HTMLInputElement).checked = state.speciesMode === 'all';
      (form.elements.namedItem('maxPrice') as HTMLSelectElement).value = state.maxPrice ? String(state.maxPrice) : '';
      (form.elements.namedItem('minDays') as HTMLSelectElement).value = state.minDays ? String(state.minDays) : '';
    };

    const optionInputs = () => [...form.querySelectorAll<HTMLInputElement>('input[data-facet]')];
    const selectedOptionCount = (state: FacetState) =>
      state.countries.length + state.regions.length + state.species.length + state.tripTypes.length + state.methods.length +
      Number(Boolean(state.q.trim())) + Number(Boolean(state.maxPrice)) + Number(Boolean(state.minDays));

    const updateSpeciesMode = (state: FacetState) => {
      const control = form.querySelector<HTMLElement>('[data-species-mode]');
      if (!control) return;
      control.hidden = state.species.length < 2;
      if (state.species.length < 2) (form.elements.namedItem('speciesMode') as HTMLInputElement).checked = false;
    };

    const updateFacetCounts = (state: FacetState) => {
      form.querySelectorAll<HTMLElement>('[data-facet-count]').forEach((element) => {
        const facet = element.dataset.facet as CategoricalFacet;
        const value = element.dataset.value ?? '';
        const optionCount = contextualFacetCount(records, state, facet, value, inactiveSources);
        element.textContent = String(optionCount);
        const input = form.querySelector<HTMLInputElement>(`input[data-facet="${CSS.escape(facet)}"][value="${CSS.escape(value)}"]`);
        if (input) input.disabled = optionCount === 0 && !input.checked;
      });
    };

    const renderChips = (state: FacetState) => {
      if (!activeFilters) return;
      activeFilters.replaceChildren();
      const appendChip = (label: string, remove: () => void) => {
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.textContent = `${label} ×`;
        chip.setAttribute('aria-label', `Remove ${label} filter`);
        chip.addEventListener('click', remove);
        activeFilters.append(chip);
      };
      const controls: Array<{ name: keyof Pick<FacetState, 'countries' | 'regions' | 'species' | 'tripTypes' | 'methods'>; value: string; label: string }> = [];
      for (const input of optionInputs().filter((item) => item.checked)) {
        const names = { country: 'countries', region: 'regions', species: 'species', tripType: 'tripTypes', method: 'methods' } as const;
        controls.push({ name: names[input.name as keyof typeof names], value: input.value, label: input.dataset.label ?? input.value });
      }
      for (const control of controls) {
        appendChip(control.label, () => {
          committedState = { ...committedState, [control.name]: committedState[control.name].filter((value) => value !== control.value) };
          writeStateToForm(committedState);
          commit(committedState);
        });
      }
      const removeConstraint = (next: FacetState) => {
        writeStateToForm(next);
        commit(next);
      };
      if (state.q.trim()) appendChip(`Search: ${state.q.trim()}`, () => removeConstraint({ ...committedState, q: '' }));
      if (state.maxPrice) appendChip(`Up to $${state.maxPrice.toLocaleString()}`, () => removeConstraint({ ...committedState, maxPrice: 0 }));
      if (state.minDays) appendChip(`${state.minDays}+ hunting days`, () => removeConstraint({ ...committedState, minDays: 0 }));
    };

    const renderResults = (state: FacetState, updateUrl = true) => {
      const matching = filterFacetRecords(records, state, inactiveSources);
      const matchingIds = new Set(matching.map((record) => record.id));
      for (const [id, card] of cards) card.hidden = !matchingIds.has(id ?? '');
      if (count) count.textContent = String(matching.length);
      if (resultLabel) resultLabel.textContent = matching.length === 1 ? 'hunt' : 'hunts';
      if (empty) empty.hidden = matching.length !== 0;
      const selectedCount = selectedOptionCount(state);
      document.querySelectorAll<HTMLElement>('[data-clear]').forEach((button) => (button.hidden = selectedCount === 0));
      if (activeCount) {
        activeCount.textContent = String(selectedCount);
        activeCount.hidden = selectedCount === 0;
      }
      renderChips(state);
      updateFacetCounts(state);
      updateSpeciesMode(state);
      if (updateUrl) {
        const params = facetStateToParams(state);
        history.replaceState(null, '', `${window.location.pathname}${params.size ? `?${params}` : ''}#hunts`);
      }
    };

    const renderDraft = (state: FacetState) => {
      const matching = filterFacetRecords(records, state, inactiveSources);
      if (draftCount) draftCount.textContent = String(matching.length);
      updateFacetCounts(state);
      updateSpeciesMode(state);
    };

    const commit = (state: FacetState, updateUrl = true) => {
      committedState = state;
      renderResults(state, updateUrl);
      if (draftCount) draftCount.textContent = String(filterFacetRecords(records, state, inactiveSources).length);
    };

    const closePanel = (restore = true) => {
      if (restore) writeStateToForm(committedState);
      if (panel) panel.dataset.open = 'false';
      if (backdrop) backdrop.dataset.open = 'false';
      if (openButton) openButton.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    };

    const openPanel = () => {
      writeStateToForm(committedState);
      renderDraft(committedState);
      if (panel) panel.dataset.open = 'true';
      if (backdrop) backdrop.dataset.open = 'true';
      if (openButton) openButton.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closeButton?.focus();
    };

    openButton?.addEventListener('click', openPanel);
    closeButton?.addEventListener('click', () => closePanel());
    backdrop?.addEventListener('click', () => closePanel());
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && panel?.dataset.open === 'true') closePanel();
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      commit(stateFromForm());
      closePanel(false);
    });

    const handleFormChange = (event: Event) => {
      if (event.target instanceof HTMLInputElement && event.target.matches('[data-facet-search]')) return;
      const draft = stateFromForm();
      if (mobileQuery.matches) renderDraft(draft);
      else commit(draft);
    };
    form.addEventListener('input', handleFormChange);

    form.querySelectorAll<HTMLInputElement>('[data-facet-search]').forEach((search) => {
      search.addEventListener('input', () => {
        const list = form.querySelector<HTMLElement>(`[data-facet-list="${search.dataset.facetSearch}"]`);
        const query = search.value.trim().toLocaleLowerCase();
        list?.querySelectorAll<HTMLElement>('[data-facet-option]').forEach((option) => {
          option.hidden = Boolean(query && !option.textContent?.toLocaleLowerCase().includes(query));
        });
      });
    });

    document.querySelectorAll<HTMLElement>('[data-clear]').forEach((button) => {
      button.addEventListener('click', () => {
        const cleared = emptyFacetState();
        writeStateToForm(cleared);
        if (mobileQuery.matches && panel?.dataset.open === 'true') renderDraft(cleared);
        else commit(cleared);
      });
    });

    window.addEventListener('popstate', () => {
      committedState = facetStateFromParams(new URLSearchParams(window.location.search));
      writeStateToForm(committedState);
      renderResults(committedState, false);
    });

    writeStateToForm(committedState);
    renderResults(committedState, false);
  }
</script>

<style>
  :global([hidden]) {
    display: none !important;
  }

  .hero {
    position: relative;
    min-height: 610px;
    display: grid;
    align-items: end;
    isolation: isolate;
    color: #fff;
    background: var(--dark) var(--hero-image) center 46% / cover no-repeat;
  }

  .hero-shade {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(90deg, rgba(8, 13, 10, 0.92) 0%, rgba(8, 13, 10, 0.66) 52%, rgba(8, 13, 10, 0.2) 100%), linear-gradient(0deg, rgba(8, 13, 10, 0.65), transparent 55%);
  }

  .hero-content {
    padding-bottom: 88px;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: #e6bd7d;
    font-size: 0.76rem;
    font-weight: 750;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .eyebrow.dark {
    color: var(--accent);
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1,
  h2 {
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  h1 {
    max-width: 780px;
    margin-bottom: 22px;
    font-size: clamp(3rem, 7vw, 6.4rem);
    line-height: 0.93;
  }

  .hero-content > p:not(.eyebrow) {
    max-width: 650px;
    margin-bottom: 30px;
    color: rgba(255, 255, 255, 0.78);
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.6;
  }

  .hero-link,
  .filters button,
  .details {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 20px;
    border: 0;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    cursor: pointer;
  }

  .catalog {
    padding-top: 88px;
    padding-bottom: 110px;
  }

  .browse-links {
    padding-top: 34px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .browse-links div {
    padding-bottom: 22px;
    display: flex;
