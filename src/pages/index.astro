---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="HuntSeeker Marketplace"
  description="Explore hunt packages from independent outfitter deployments."
>
  <section class="container hero">
    <div>
      <p class="eyebrow">HuntSeeker Marketplace</p>
      <h1>Public hunt pages, synced from trusted outfitters.</h1>
      <p class="lede">
        This marketplace app will render cached, SEO-ready hunt pages from the
        marketplace database and mirrored media storage.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: 100vh;
    display: grid;
    align-items: center;
    padding: 96px 0;
  }

  .hero > div {
    max-width: 760px;
  }

  .eyebrow {
    margin: 0 0 18px;
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    max-width: 780px;
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: 0;
  }

  .lede {
    max-width: 650px;
    margin: 28px 0 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    line-height: 1.55;
  }
</style>
