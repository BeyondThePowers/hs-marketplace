---
import HuntCard from '../../components/HuntCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadCatalogSnapshot, mediaUrl } from '../../lib/catalog-build';
import { destinationSlug, huntDestinations } from '../../lib/hunt-destinations';

export const prerender = true;

export async function getStaticPaths() {
  const catalog = await loadCatalogSnapshot();
  const destinations = new Map<string, { name: string; country: string; hunts: typeof catalog.hunts }>();
  for (const hunt of catalog.hunts) {
    for (const destination of huntDestinations(hunt.destinations)) {
      const slug = destinationSlug(destination);
      const existing = destinations.get(slug) ?? { name: destination.region.name, country: destination.country.name, hunts: [] };
      existing.hunts.push(hunt);
      destinations.set(slug, existing);
    }
  }
  return [...destinations.entries()].map(([slug, destination]) => ({
    params: { slug },
    props: {
      ...destination,
      cards: destination.hunts.map((hunt) => ({ hunt, media: catalog.huntMedia.find((item) => item.hunt_id === hunt.id) })),
    },
  }));
}

const { name, country, cards } = Astro.props;
const species = [...new Set(cards.flatMap(({ hunt }) => hunt.primary_species ?? []))].sort();
const heroImage = mediaUrl(cards[0]?.media);
const canonicalPath = `/destinations/${Astro.params.slug}`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Hunting in ${name}, ${country}`,
  description: `Compare ${cards.length} guided hunts in ${name}, ${country}.`,
  about: { '@type': 'Place', name: `${name}, ${country}` },
  mainEntity: { '@type': 'ItemList', numberOfItems: cards.length, itemListElement: cards.map(({ hunt }, index) => ({ '@type': 'ListItem', position: index + 1, name: hunt.title, url: new URL(`/hunts/${hunt.listing_id}`, Astro.site ?? Astro.url.origin).toString() })) },
};
---

<BaseLayout title={`Hunting in ${name}, ${country} | HuntSeeker`} description={`Compare guided hunts, species, seasons, and package details for ${name}, ${country}.`} canonicalPath={canonicalPath} image={heroImage} structuredData={schema}>
  <section class="collection-hero" style={heroImage ? `--hero-image: url('${heroImage}')` : undefined}><div class="shade"></div><div class="container"><p>Destination guide</p><h1>Hunting in {name}</h1><span>{country}</span></div></section>
  <section class="container collection"><div class="intro"><div><p class="eyebrow">Available hunts</p><h2>Compare {cards.length} {cards.length === 1 ? 'hunt' : 'hunts'}</h2></div><p>Current packages include {species.join(', ')}. Review methods, lodging, travel, pricing, and terms on each hunt page.</p></div><div class="hunt-grid">{cards.map(({ hunt, media }) => <HuntCard hunt={hunt} media={media} />)}</div></section>
</BaseLayout>

<style>
  .collection-hero { position: relative; min-height: 430px; display: grid; align-items: end; isolation: isolate; background: var(--dark) var(--hero-image) center / cover no-repeat; color: #fff; }
  .shade { position: absolute; z-index: -1; inset: 0; background: linear-gradient(0deg, rgba(7,12,8,.9), rgba(7,12,8,.18)); }
  .collection-hero .container { padding-bottom: 58px; }
  .collection-hero p, .eyebrow { margin: 0 0 10px; color: #e6bd7d; font-size: .75rem; font-weight: 750; letter-spacing: .11em; text-transform: uppercase; }
  h1, h2 { margin: 0; font-family: Georgia, 'Times New Roman', serif; font-weight: 500; letter-spacing: -.04em; }
  h1 { font-size: clamp(3rem, 7vw, 6rem); line-height: .96; }
  .collection-hero span { display: block; margin-top: 12px; color: rgba(255,255,255,.72); }
  .collection { padding-top: 72px; padding-bottom: 100px; }
  .intro { margin-bottom: 38px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: end; }
  .intro h2 { font-size: clamp(2.4rem, 5vw, 4rem); }
  .intro > p { margin: 0; color: var(--muted); line-height: 1.65; }
  .hunt-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  @media (max-width: 900px) { .hunt-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .intro { grid-template-columns: 1fr; gap: 18px; } .hunt-grid { grid-template-columns: 1fr; } }
</style>
